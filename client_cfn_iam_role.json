{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Metadata": {
        "Version": "1.0.0",
        "Author": "Braid",
        "LastUpdated": "2025-01-21",
        "Purpose": "Allow Braid to securely access and manage the AWS account while maintaining compliance and restricting sensitive actions."
    },
    "Description": "Enable Braid to access and manage the AWS account securely.",
    "Resources": {
        "Braid": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "RoleName": "x_braid_access",
                "MaxSessionDuration": 3600,
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "arn:aws:iam::992382720710:root"
                            },
                            "Action": "sts:AssumeRole",
                            "Condition": {
                                "Bool": {
                                    "aws:MultiFactorAuthPresent": "true"
                                }
                            }
                        },
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "arn:aws:iam::339713052484:role/tool_cloud_ide"
                            },
                            "Action": "sts:AssumeRole"
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/AdministratorAccess"
                ],
                "Policies": [
                    {
                        "PolicyName": "RestrictIAMManagement",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Effect": "Deny",
                                    "Action": [
                                        "iam:CreateUser",
                                        "iam:UpdateUser",
                                        "iam:DeleteUser",
                                        "iam:CreateAccessKey",
                                        "iam:DeleteAccessKey",
                                        "iam:UpdateAccessKey"
                                    ],
                                    "Resource": "*"
                                }
                            ]
                        }
                    },
                    {
                        "PolicyName": "ProtectCloudTrail",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Effect": "Deny",
                                    "Action": [
                                        "cloudtrail:StopLogging",
                                        "cloudtrail:DeleteTrail",
                                        "cloudtrail:UpdateTrail"
                                    ],
                                    "Resource": "*"
                                }
                            ]
                        }
                    },
                    {
                        "PolicyName": "DeleteProtectionCFN",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Effect": "Deny",
                                    "Action": "cloudformation:DeleteStack",
                                    "Resource": [
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-networking/*" },
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-authentication/*" },
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-database/*" },
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-database-jcard/*" },
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-api-banking/*" },
                                        { "Fn::Sub": "arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/braid-web-dashboard/*" }
                                    ]
                                }
                            ]
                        }
                    }
                ],
                "Tags": [
                    {
                        "Key": "Environment",
                        "Value": "Production"
                    },
                    {
                        "Key": "Project",
                        "Value": "Braid"
                    },
                    {
                        "Key": "Service",
                        "Value": "Access"
                    }
                ]
            }
        }
    },
    "Outputs": {
        "AccountId": {
            "Description": "The AWS Account ID where this stack is deployed",
            "Value": {
                "Ref": "AWS::AccountId"
            }
        }
    }
}